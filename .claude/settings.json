{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(make)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git merge-base*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh run rerun*)",
      "Bash(gh api *)",
      "Bash(harness/scripts/risk-level.sh*)",
      "Bash(./harness/scripts/risk-level.sh*)",
      "Bash(harness/scripts/review-rules.sh*)",
      "Bash(./harness/scripts/review-rules.sh*)",
      "Bash(harness/scripts/review-status.sh*)",
      "Bash(./harness/scripts/review-status.sh*)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh label*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *labels*)",
      "Bash(gh api graphql*)",
      "Bash(gh issue edit*)",
      "Bash(gh secret*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./harness/policies/**)",
      "Edit(./harness/scripts/human-gate.sh)",
      "Edit(./.github/workflows/auto-merge.yml)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-reminder.sh"
          }
        ]
      }
    ]
  }
}
