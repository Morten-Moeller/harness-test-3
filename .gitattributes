# Line endings: LF in the repository and in every checkout. A CRLF shebang breaks scripts.
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Generated files (make generate). GitHub folds them in the pull request view.
backend/internal/api/api.gen.go linguist-generated=true
backend/internal/store/*.go linguist-generated=true
frontend/src/api/schema.d.ts linguist-generated=true
